# ESPN Fantasy Basketball Configuration
# Copy this file to .env and fill in your values

# Your ESPN Fantasy Basketball league ID
# Found in the URL: fantasy.espn.com/basketball/league?leagueId=XXXXXXXX
LEAGUE_ID=your_league_id_here

# The season year (e.g., 2025 for the 2024-25 season)
SEASON_YEAR=2025

# Private league authentication cookies
# How to get these:
#   1. Log in to ESPN Fantasy on your browser
#   2. Open DevTools (F12) -> Application -> Cookies -> fantasy.espn.com
#   3. Copy the values for espn_s2 and SWID
ESPN_S2=your_espn_s2_cookie_here
SWID=your_swid_cookie_here
